{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/config.yml",
      "destination": "/admin/config.yml"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api|admin|images|_next|static|[\\w-]+\\.\\w+).*)",
      "destination": "/index.html"
    }
  ]
}
